# Конфігурація для Instagram AI Агента (ProstoDev)

# 1. Instagram акаунт
IG_USERNAME=prostodev.ua
IG_PASSWORD=твій_пароль_тут

# 2. Telegram для сповіщень та дзвінків тобі
# Створи бота в @BotFather і отримай токен, а свій chat_id дізнайся через @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_MY_CHAT_ID=

# 3. AI Мозок (Gemini API - безкоштовний ключ береться на aistudio.google.com)
GEMINI_API_KEY=
